{
  "name": "@dotpm/cli",
  "version": "0.1.0",
  "description": "Command line for dotpm, the Obsidian project manager: list, search and edit tasks from a terminal or an agent",
  "keywords": ["cli", "mcp", "obsidian", "project-management", "tasks"],
  "homepage": "https://github.com/dotpm/cli#readme",
  "license": "MIT",
  "repository": "github:dotpm/cli",
  "bin": { "dotpm": "./dist/dotpm.js" },
  "files": ["dist"],
  "type": "module",
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsdown",
    "check": "run-p check:**",
    "check:code": "oxlint ./src",
    "check:format": "oxfmt --check ./src",
    "check:types": "tsc -noEmit -skipLibCheck",
    "fix": "run-p fix:**",
    "fix:code": "oxlint --fix ./src",
    "fix:format": "oxfmt ./src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@2bad/axiom": "2.1.0",
    "@2bad/tsconfig": "4.0.0",
    "@dotpm/api": "0.1.0",
    "@types/node": "26.4.1",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": { "node": ">=22" },
  "volta": { "node": "24.15.0", "pnpm": "11.5.3" }
}
